{% render 'hakutakagami-section-style' %}

{%- assign s = section.settings -%}

<section class="hklp-section hklp-intro hklp-brand">
  <div class="hklp-container">
    <div class="hklp-intro__inner">
      <div class="hklp-intro__copy">
        {%- if s.eyebrow != blank -%}
          <span class="hklp-eyebrow">{{ s.eyebrow }}</span>
        {%- endif -%}
        <h2 class="hklp-heading">{{ s.heading }}</h2>
        {%- comment -%}
          「創業90年以上」などの実績表記は、公式サイトまたは商品ページで
          確認できる場合のみ本文に残すこと。
        {%- endcomment -%}
        <div class="hklp-lead">{{ s.body }}</div>
      </div>
      <div class="hklp-intro__media">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1200 | image_tag:
            widths: '600, 900, 1200',
            sizes: '(min-width: 990px) 560px, 100vw',
            alt: s.image_alt,
            loading: 'lazy'
          }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LP：メーカーの信頼性",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "小見出し（任意）",
      "default": "ABOUT hakutaka"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "愛犬が毎日着るものだから、着心地にもこだわりました。"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "本文",
      "default": "<p>hakutakaは、創業90年以上のインナーメーカー。<br>長年培ってきた肌着づくりの知見を活かし、素材や着心地に配慮した商品づくりを行っています。</p>",
      "info": "「創業90年以上」の表記は、公式サイトまたは商品ページに記載がある場合のみ使用してください。"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "イメージ画像（任意）"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "画像の代替テキスト",
      "default": "hakutakaのものづくり"
    },
    {
      "type": "header",
      "content": "色・余白"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景色",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "テキスト色",
      "default": "#1c2b33"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "アクセントカラー",
      "default": "#e3f5ee"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上部余白",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下部余白",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "LP：メーカーの信頼性"
    }
  ]
}
{% endschema %}
