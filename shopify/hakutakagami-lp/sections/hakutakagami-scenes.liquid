{% render 'hakutakagami-section-style' %}

{%- assign s = section.settings -%}

<section class="hklp-section hklp-scenes">
  <div class="hklp-container">
    <header class="hklp-section-head">
      <h2 class="hklp-heading">{{ s.heading }}</h2>
      {%- if s.body != blank -%}
        <div class="hklp-lead">{{ s.body }}</div>
      {%- endif -%}
    </header>

    <div class="hklp-scenes__grid">
      {%- for block in section.blocks -%}
        <figure class="hklp-scene-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag:
              widths: '400, 600, 800',
              sizes: '(min-width: 750px) 240px, 45vw',
              alt: block.settings.image_alt,
              loading: 'lazy'
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          {%- endif -%}
          <figcaption class="hklp-scene-card__label">{{ block.settings.label }}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LP：着用シーン",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "いつもの夏のお出かけを、もっと楽しく。"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "本文",
      "default": "<p>お散歩でも、旅行でも、写真を撮る日でも。<br>思わず誰かに見せたくなる、愛犬の夏コーデ。</p>"
    },
    {
      "type": "header",
      "content": "色・余白"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景色",
      "default": "#fdf9e9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "テキスト色",
      "default": "#1c2b33"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "アクセントカラー（画像プレースホルダー背景）",
      "default": "#fff3c4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上部余白",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下部余白",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "scene",
      "name": "シーン",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "シーン名"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "写真",
          "info": "写真素材が用意できるまでは未設定のままで問題ありません（プレースホルダーが表示されます）。"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "画像の代替テキスト"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP：着用シーン",
      "blocks": [
        { "type": "scene", "settings": { "label": "朝夕のお散歩" } },
        { "type": "scene", "settings": { "label": "公園へのお出かけ" } },
        { "type": "scene", "settings": { "label": "カフェや旅行" } },
        { "type": "scene", "settings": { "label": "夏の記念撮影" } },
        { "type": "scene", "settings": { "label": "多頭飼いのお揃いコーデ" } }
      ]
    }
  ]
}
{% endschema %}
