{% render 'hakutakagami-section-style' %}

{%- assign s = section.settings -%}

<section class="hklp-section hklp-final">
  <div class="hklp-container">
    <header class="hklp-section-head">
      <h2 class="hklp-heading">{{ s.heading }}</h2>
      <div class="hklp-lead">{{ s.body }}</div>
    </header>

    <div class="hklp-final__grid">
      {%- for block in section.blocks -%}
        {% render 'hakutakagami-product-card', block: block, cta_position: 'final-cta', lazy: true %}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LP：最終CTA",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "この夏、うちの子もアートを着よう。"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "本文",
      "default": "<p>ひんやり快適な着心地と、<br>思わず笑顔になるユーモアを。</p><p>夏のお散歩がもっと楽しくなる、<br>hakutakagamiの接触冷感ドッグウェア。</p>"
    },
    {
      "type": "header",
      "content": "色・余白"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "背景色",
      "default": "#eaf6fb"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "テキスト色",
      "default": "#1c2b33"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "アクセントカラー",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上部余白",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下部余白",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "商品カード",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "商品（選択すると価格・売り切れが自動反映）"
        },
        {
          "type": "text",
          "id": "title",
          "label": "商品名（商品未選択時に表示）"
        },
        {
          "type": "text",
          "id": "catchcopy",
          "label": "キャッチコピー（任意）"
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "価格（商品未選択時に表示）",
          "default": "2,480円（税込）"
        },
        {
          "type": "url",
          "id": "link",
          "label": "商品ページURL（商品未選択時に使用）"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA文言",
          "default": "詳しく見る"
        },
        {
          "type": "header",
          "content": "画像"
        },
        {
          "type": "image_picker",
          "id": "image_a",
          "label": "画像A"
        },
        {
          "type": "text",
          "id": "image_a_url",
          "label": "画像A（URL指定・画像A未設定時に使用）"
        },
        {
          "type": "text",
          "id": "color_a",
          "label": "カラーA名"
        },
        {
          "type": "image_picker",
          "id": "image_b",
          "label": "画像B"
        },
        {
          "type": "text",
          "id": "image_b_url",
          "label": "画像B（URL指定・画像B未設定時に使用）"
        },
        {
          "type": "text",
          "id": "color_b",
          "label": "カラーB名"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LP：最終CTA",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "title": "涼ティー",
            "link": "/products/pets04",
            "image_a_url": "https://hakutaka-shop.com/cdn/shop/files/5.png?v=1780535715",
            "color_a": "ミント",
            "image_b_url": "https://hakutaka-shop.com/cdn/shop/files/6_280f9992-c140-4160-bc4f-70231d473387.png?v=1780535715",
            "color_b": "ピンク"
          }
        },
        {
          "type": "product",
          "settings": {
            "title": "なんかちょっといい気分",
            "link": "/products/pets05",
            "image_a_url": "https://hakutaka-shop.com/cdn/shop/files/4_45d87179-b313-47ce-a0ef-3aae76fb9c1a.png?v=1780535715",
            "color_a": "ミント",
            "image_b_url": "https://hakutaka-shop.com/cdn/shop/files/3_76bc1cc3-6bf2-473e-8aaf-51811c0c2197.png?v=1780535715",
            "color_b": "パープル"
          }
        },
        {
          "type": "product",
          "settings": {
            "title": "なんかちょっとかいてき",
            "link": "/products/pets06",
            "image_a_url": "https://hakutaka-shop.com/cdn/shop/files/2_e70f0f65-84cc-46e2-abc1-fe7f24e0d865.png?v=1780535715",
            "color_a": "イエロー",
            "image_b_url": "https://hakutaka-shop.com/cdn/shop/files/1.png?v=1780535715",
            "color_b": "ブルー"
          }
        }
      ]
    }
  ]
}
{% endschema %}
