{% render 'hakutakagami-section-style' %}

{%- assign s = section.settings -%}

<section class="hklp-section hklp-colors">
  <div class="hklp-container">
    <header class="hklp-section-head">
      <h2 class="hklp-heading">{{ s.heading }}</h2>
    </header>

    <ul class="hklp-colors__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign bs = block.settings -%}
        <li {{ block.shopify_attributes }}>
          {%- if bs.link != blank -%}
            <a href="{{ bs.link }}" class="hklp-color-item">
          {%- else -%}
            <span class="hklp-color-item">
          {%- endif -%}
            <span class="hklp-color-item__media">
              {%- assign chip_alt = bs.product_name | append: ' ' | append: bs.color_name -%}
              {%- if bs.image != blank -%}
                {{ bs.image | image_url: width: 400 | image_tag:
                  widths: '200, 400',
                  sizes: '(min-width: 990px) 160px, 40vw',
                  alt: chip_alt,
                  loading: 'lazy'
                }}
              {%- elsif bs.image_url != blank -%}
                <img src="{{ bs.image_url }}" alt="{{ chip_alt | escape }}" width="400" height="400" loading="lazy">
              {%- else -%}
                <span class="hklp-color-item__chip" style="background-color: {{ bs.chip_color }};" aria-hidden="true"></span>
              {%- endif -%}
            </span>
            <span class="hklp-color-item__product">{{ bs.product_name }}</span>
            <span class="hklp-color-item__name">{{ bs.color_name }}</span>
          {%- if bs.link != blank -%}
            </a>
          {%- else -%}
            </span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if s.note != blank -%}
      <p class="hklp-colors__note">{{ s.note }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
